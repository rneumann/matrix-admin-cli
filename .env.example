# Base URL of the Matrix homeserver (e.g. Synapse), including scheme, no trailing slash
MATRIX_HOMESERVER_URL=https://matrix.example.org

# Username (localpart or full user ID) of a user with server admin rights
MATRIX_ADMIN_USER=

# This user's password (exchanged for an access token via login on startup)
MATRIX_ADMIN_PASSWORD=

# Server name / domain as used in user IDs (@user:server_name)
MATRIX_SERVER_NAME=example.org

# Optional: room ID of the server admin room (with a running admin bot). Only
# needed for "room promote" (!admin users force-promote).
MATRIX_ADMIN_ROOM_ID=

# Optional: credentials of a second account that should receive admin rights
# (power level) via "grant-admin"/"grant-admin-all" in rooms MATRIX_ADMIN_USER
# is already a member of. Flow: MATRIX_ADMIN_USER invites, MATRIX_TARGET_USER
# accepts itself.
MATRIX_TARGET_USER=
MATRIX_TARGET_PASSWORD=
