# Basis-URL des Matrix-Homeservers (z.B. Synapse), inkl. Schema, ohne trailing slash
MATRIX_HOMESERVER_URL=https://matrix.h-ka.de

# Admin-Access-Token eines Nutzers mit Server-Admin-Rechten (fuer die Synapse Admin API)
MATRIX_ADMIN_TOKEN=

# Server-Name / Domain, wie er in User-IDs verwendet wird (@user:server_name)
MATRIX_SERVER_NAME=h-ka.de
