# Basis-URL des Matrix-Homeservers (z.B. Synapse), inkl. Schema, ohne trailing slash
MATRIX_HOMESERVER_URL=https://matrix.h-ka.de

# Benutzername (Localpart oder volle User-ID) eines Nutzers mit Server-Admin-Rechten
MATRIX_ADMIN_USER=

# Passwort dieses Nutzers (wird beim Start per Login gegen die Client-Server API getauscht)
MATRIX_ADMIN_PASSWORD=

# Server-Name / Domain, wie er in User-IDs verwendet wird (@user:server_name)
MATRIX_SERVER_NAME=h-ka.de

# Optional: Room-ID des Server-Admin-Rooms (mit laufendem Admin-Bot). Wird nur
# fuer "room promote" gebraucht (!admin users force-promote).
MATRIX_ADMIN_ROOM_ID=

# Optional: Zugangsdaten eines zweiten Accounts, der per "grant-admin"/"grant-admin-all"
# Admin-Rechte (Power-Level) in Raeumen erhalten soll, in denen MATRIX_ADMIN_USER bereits
# Mitglied ist. Ablauf: MATRIX_ADMIN_USER laedt ein, MATRIX_TARGET_USER nimmt selbst an.
MATRIX_TARGET_USER=
MATRIX_TARGET_PASSWORD=
